# omega — copy this to `.env` and fill in the key. `.env` is gitignored.
#
#     cp .env.example .env
#
# Nothing reads this file but `python/omega/provider.py`, which is the only
# place in omega that knows an LLM exists. A value already exported in your
# shell wins over the one here, because exporting is the more deliberate act.

# Required. Nothing else in omega needs a secret.
OPENAI_API_KEY=sk-...

# Optional — the two roles, and why there are two.
#
# `judge` runs on every event, including every idle tick, and its answer is
# almost always "do nothing". It wants to be small and fast, because you pay
# for it constantly.
#
# `act` runs rarely and does the actual work. It wants to be capable, because
# you pay for it only when something is actually happening.
#
# Both default to the values below, so you can leave them unset.
OMEGA_MODEL_JUDGE=gpt-4o-mini
OMEGA_MODEL_ACT=gpt-4o
